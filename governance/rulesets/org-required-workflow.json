{
  "name": "acme-guardrails-required-workflow",
  "target": "branch",
  "enforcement": "evaluate",
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] },
    "repository_property": {
      "include": [{ "name": "guardrails", "property_values": ["enforced"] }],
      "exclude": []
    }
  },
  "bypass_actors": [],
  "rules": [
    {
      "type": "workflows",
      "parameters": {
        "do_not_enforce_on_create": false,
        "workflows": [
          {
            "path": ".github/workflows/required-guardrails.yml",
            "repository_id": 0,
            "ref": "refs/tags/v1"
          }
        ]
      }
    }
  ]
}
