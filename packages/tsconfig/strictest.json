{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "ACME strictest (opt-in target for mature repos)",
  "extends": "./base.json",
  "compilerOptions": {
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noPropertyAccessFromIndexSignature": true
  }
}
